{
  "python.defaultInterpreterPath": "${workspaceFolder}/.dev/venv-mocks/bin/python",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["mocks/tests"],
  "python.envFile": "${workspaceFolder}/.dev/dev.env",
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true
  },
  "search.exclude": {
    ".dev": true
  }
}
