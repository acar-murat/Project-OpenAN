{
  // Thin wrappers over scripts/dev.py, which works the same from any terminal.
  // Terminal > Run Task... ; "dev: test" is the default test task.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev: setup",
      "detail": "Create .dev/ virtualenvs and dev.env (skips what is already up to date)",
      "type": "shell",
      "command": "python3",
      "windows": { "command": "python" },
      "args": ["scripts/dev.py", "setup"],
      "problemMatcher": []
    },
    {
      "label": "dev: setup + UIs",
      "detail": "dev: setup, then npm install for both web UIs if needed (needs Node 20+)",
      "type": "shell",
      "command": "python3",
      "windows": { "command": "python" },
      "args": ["scripts/dev.py", "setup", "--ui"],
      "problemMatcher": []
    },
    {
      "label": "dev: ui setup",
      "detail": "npm install for both web UIs if needed (rewrites the lockfiles' npmmirror host to npmjs)",
      "type": "shell",
      "command": "python3",
      "windows": { "command": "python" },
      "args": ["scripts/dev.py", "ui-setup"],
      "problemMatcher": []
    },
    {
      "label": "dev: up (background)",
      "detail": "Start Registry, mock LLM, Orchestration, mock price API, mock MAE and mock Energy Agent",
      "type": "shell",
      "command": "python3",
      "windows": { "command": "python" },
      "args": ["scripts/dev.py", "up"],
      "problemMatcher": []
    },
    {
      "label": "dev: up + UIs (background)",
      "detail": "Also start the OpenAN console on http://127.0.0.1:3003 and the Registry UI on :3004",
      "type": "shell",
      "command": "python3",
      "windows": { "command": "python" },
      "args": ["scripts/dev.py", "up", "--ui"],
      "problemMatcher": []
    },
    {
      "label": "dev: status",
      "type": "shell",
      "command": "python3",
      "windows": { "command": "python" },
      "args": ["scripts/dev.py", "status"],
      "problemMatcher": []
    },
    {
      "label": "dev: down",
      "detail": "Stop everything started by dev: up",
      "type": "shell",
      "command": "python3",
      "windows": { "command": "python" },
      "args": ["scripts/dev.py", "down"],
      "problemMatcher": []
    },
    {
      "label": "dev: demo",
      "detail": "Run the UC1 end-to-end demo against the running services",
      "type": "shell",
      "command": "python3",
      "windows": { "command": "python" },
      "args": ["scripts/dev.py", "demo"],
      "problemMatcher": []
    },
    {
      "label": "dev: demo via Orchestration Center",
      "detail": "Run UC1 through the Orchestration Center and mock Energy Agent, as the Execution Center does",
      "type": "shell",
      "command": "python3",
      "windows": { "command": "python" },
      "args": ["scripts/dev.py", "demo-orch"],
      "problemMatcher": []
    },
    {
      "label": "dev: test",
      "detail": "ruff + pytest for mocks/ and scripts/",
      "type": "shell",
      "command": "python3",
      "windows": { "command": "python" },
      "args": ["scripts/dev.py", "test"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "dev: ci",
      "detail": "Everything CI runs: setup, test, up, the direct and orchestrated demos, down",
      "type": "shell",
      "command": "python3",
      "windows": { "command": "python" },
      "args": ["scripts/dev.py", "ci"],
      "problemMatcher": []
    }
  ]
}
