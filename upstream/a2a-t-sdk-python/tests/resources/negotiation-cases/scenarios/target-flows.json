[
  {
    "id": "SC-TGT-01",
    "summary": "修复目标协商单轮闭环：工作台就专线质差修复目标发起目标协商提议，OMC 确认最终意图生成接受消息，工作台校验提取时延目标与完成时限参数",
    "languages": ["zh-CN"],
    "roles": ["A", "B"],
    "rolesDesc": {
      "A": "工作台（client，修复目标协商发起/确认方）",
      "B": "OMC（server，修复目标澄清/确认方）"
    },
    "steps": [
      {
        "step": 1,
        "role": "A",
        "api": "generateProposeFromText",
        "context": { "id": "3dbc13b5-bd57-4c2b-b503-24e381b6c8d3", "round": 1, "maxRounds": 5 },
        "templateUri": "Negotiation-T/target-negotiation/propose/v1",
        "input": {
          "text": {
            "zh-CN": "专线质差投诉的修复目标协商：修复意图是在2026年5月15日前将深圳至广州专线的平均时延恢复至20ms以内，高峰时段丢包率不高于1%；待澄清平均时延目标是恢复至20ms以内还是50ms以内、修复完成时限是48小时内还是72小时内，请澄清并确认。"
          }
        },
        "llm": { "script": [ { "$ref": "responses/extract.target.propose.full" } ] },
        "expect": {
          "outcome": "success",
          "llmCalls": 1,
          "promptTextEqualsGolden": "target_propose"
        }
      },
      {
        "step": 2,
        "role": "B",
        "api": "generateAcceptFromText",
        "context": { "id": "3dbc13b5-bd57-4c2b-b503-24e381b6c8d3", "round": 2, "maxRounds": 5 },
        "templateUri": "Negotiation-T/target-negotiation/accept-reject/v1",
        "input": {
          "text": {
            "zh-CN": "最终确认的意图：在2026年5月15日前将深圳至广州专线的平均时延恢复至20ms以内，高峰时段丢包率不高于1%。"
          }
        },
        "llm": { "script": [ { "$ref": "responses/extract.target.accept.full" } ] },
        "expect": {
          "outcome": "success",
          "llmCalls": 1,
          "promptTextEqualsGolden": "target_accept",
          "contracts": ["conclusionLiteralPresent"]
        }
      },
      {
        "step": 3,
        "role": "A",
        "api": "validateAcceptPromptAndDataFilling",
        "context": { "id": "3dbc13b5-bd57-4c2b-b503-24e381b6c8d3", "round": 2, "maxRounds": 5 },
        "templateUri": "Negotiation-T/target-negotiation/accept-reject/v1",
        "prompt": { "fromStep": 2 },
        "schema": {
          "type": "object",
          "properties": {
            "latency_target": { "type": "string" },
            "repair_deadline": { "type": "string" }
          }
        },
        "llm": { "script": [ { "$ref": "responses/semantic.target.accept.full" } ] },
        "expect": {
          "outcome": "success",
          "llmCalls": 1,
          "params": {
            "id": "3dbc13b5-bd57-4c2b-b503-24e381b6c8d3",
            "round": 2,
            "maxRounds": 5,
            "latency_target": "within 20ms",
            "repair_deadline": "2026-05-15"
          },
          "contracts": ["contextKeysInMergedParams"]
        }
      }
    ],
    "expectFlow": {
      "terminalCondition": "accept",
      "roundsUsed": 2,
      "distinctMessages": true
    }
  },
