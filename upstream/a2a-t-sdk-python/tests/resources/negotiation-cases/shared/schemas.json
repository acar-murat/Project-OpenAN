{
  "biz.complaint.params": {
    "type": "object",
    "properties": {
      "accessPort": {
        "type": "string",
        "description": "接入端口名称，唯一标识被投诉的专线对象，必填，须与投诉对象一致",
        "examples": [
          "P533-珠江旧城-PTN3900-23-TPA1EG24-1",
          "P781-前海-PTN7900-5-TPA1EG24-09(cvlan=100)"
        ]
      },
      "bizScenario": {
        "type": "string",
        "description": "投诉分类场景，必填，仅允许取值：专线中断、专线质差",
        "examples": [
          "专线中断",
          "专线质差"
        ]
      },
      "faultTime": {
        "type": "string",
        "description": "问题发生时间，建议使用 ISO-8601 时间戳，例如 2026-05-11T08:21:46Z"
      },
      "eventSerialNo": {
        "type": "string",
        "description": "OSS 侧受理的投诉工单或事件流水号，供诊断回溯关联，例如 event-id-20260511-09013"
      }
    },
    "required": [
      "accessPort",
      "bizScenario"
    ]
  },
  "flat": {
    "type": "object",
    "properties": {
      "region": {
        "type": "string"
      }
    }
  },
  "noType": {
    "properties": {
      "region": {
        "type": "string"
      }
    }
  },
  "no_type": {
    "properties": {
      "region": {
        "type": "string"
      }
    }
  },
  "nestedArray": {
    "type": "object",
    "properties": {
      "regions": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "nested_array": {
    "type": "object",
    "properties": {
      "regions": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "colliding": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "round": {
        "type": "integer"
      }
    }
  },
  "empty": {}
}
