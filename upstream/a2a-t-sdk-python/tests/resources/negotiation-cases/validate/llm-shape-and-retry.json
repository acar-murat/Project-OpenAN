      "params": {
        "id": "3dbc13b5-bd57-4c2b-b503-24e381b6c8d3",
        "round": 2,
        "maxRounds": 5,
        "accessPort": "P533-珠江旧城-PTN3900-23-TPA1EG24-1",
        "bizScenario": "专线质差"
