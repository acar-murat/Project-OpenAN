<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Pragmatic Checkstyle rules for the workflow engine.
  Formatting (indent, line length, import order) is handled by Spotless;
  this config focuses on naming, complexity, and structural checks.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>

    <property name="severity" value="error"/>

    <module name="SuppressionFilter">
        <property name="file" value="${config_loc}/checkstyle-suppressions.xml"/>
        <property name="optional" value="false"/>
    </module>

    <!-- File-level checks -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>
    <module name="NewlineAtEndOfFile"/>

    <!-- TreeWalker: AST-based checks -->
    <module name="TreeWalker">

        <!-- Naming conventions (underscores allowed in method names: spec-section test cases) -->
        <module name="TypeName"/>
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9_]*$"/>
        </module>
        <module name="MemberName"/>
        <module name="ParameterName"/>
        <module name="LocalVariableName"/>
        <!-- Allow conventional lowercase names: log (SLF4J), mapper (Jackson) -->
        <module name="ConstantName">
            <property name="format" value="^log$|^mapper$|^cardMapper$|^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
        </module>
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>

        <!-- Imports: unused/redundant are errors; star imports warned (cleanup ongoing) -->
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>

        <!-- Complexity (thresholds calibrated for existing codebase; tighten over time) -->
        <module name="CyclomaticComplexity">
            <property name="max" value="35"/>
        </module>
        <module name="MethodLength">
            <property name="max" value="150"/>
        </module>
        <module name="ParameterNumber">
            <property name="max" value="12"/>
        </module>
        <module name="NestedIfDepth">
            <property name="max" value="3"/>
        </module>
        <module name="NestedTryDepth">
            <property name="max" value="2"/>
        </module>

        <!-- Common bug patterns -->
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="expected|ignore|ignored"/>
        </module>
        <module name="EqualsHashCode"/>
        <module name="StringLiteralEquality"/>
        <module name="ArrayTypeStyle"/>
        <module name="OneStatementPerLine"/>

        <!-- Design -->
        <module name="HideUtilityClassConstructor"/>
        <module name="InterfaceIsType"/>
        <module name="MutableException"/>

    </module>
</module>
