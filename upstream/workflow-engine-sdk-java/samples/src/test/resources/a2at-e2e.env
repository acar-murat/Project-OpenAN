A2AT_LANGUAGE=zh-CN
A2AT_PROMPT_SOURCE_TYPE=classpath
A2AT_PROMPT_COMPLIANCE_ENABLED=false
A2AT_LLM_PROVIDER=workflow-engine-e2e-test
A2AT_LLM_MODEL=offline-e2e-model
A2AT_LLM_API_KEY=test-key-not-used
A2AT_LLM_BASE_URL=https://llm.example.test/v1
A2AT_LLM_MAX_TOKENS=256
A2AT_LLM_TEMPERATURE=0
A2AT_LLM_TIMEOUT_SECONDS=1
A2AT_LLM_HISTORY_WINDOW=1
A2AT_LLM_DISABLE_SYSTEM_PROXY=true
A2AT_LLM_SESSION_MAX_TOTAL=10
A2AT_LLM_SESSION_MAX_PER_PROVIDER=10
A2AT_LLM_MAX_ATTEMPTS=1
A2AT_NEGOTIATION_STATE_STORE_TYPE=in_memory
