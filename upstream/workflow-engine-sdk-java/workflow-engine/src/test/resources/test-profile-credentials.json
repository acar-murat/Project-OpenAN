{
  "profiles": {
    "shared": {
      "bearerAuth": {
        "login_url": "https://shared.example.test/token",
        "request_fields": {
          "userName": "shared-user",
          "value": "shared-password"
        },
        "token_field": "accessSession"
      }
    }
  },
  "agents": {
    "City 1": {
      "profile": "shared",
      "overrides": {
        "bearerAuth": {
          "login_url": "https://city1.example.test/token",
          "request_fields": {
            "value": "city1-password"
          }
        }
      }
    },
    "City 2": {
      "profile": "shared"
    }
  }
}
