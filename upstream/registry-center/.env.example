# Copy to .env and set secrets referenced by models.yaml or etc/conf/db profiles.
# Model names, URLs, protocol profiles, and options belong in models.yaml.
#
# Read by:
#   - common/llm/config/model_sources.py, which resolves every `*_env` name in
#     models.yaml (and api_key_env) from the process environment first and then
#     from this file. A name listed in models.yaml but set nowhere is a hard
#     error at load time, not an empty key.
#   - docker-compose.yml `env_file: .env`, which passes these variables into the
#     container; the entrypoint does not use them.
# .env is Git-ignored and excluded from the Docker build context and from Cloud
# Build uploads, so secrets never reach an image.
LLM_CHAT_API_KEY=your-secret
# Names below are examples only: the field that uses a secret declares its own
# variable name, so any name works as long as models.yaml and this file agree.
# LLM_EMBED_API_KEY=your-secret
# The AOC embed example in models.yaml.example / README uses both of these:
# LLM_EMBED_AUTH_APP_KEY=your-app-key
# LLM_EMBED_AUTH_APP_SECRET=your-app-secret
# LLM_RERANK_AUTH_APP_KEY=your-app-key
# LLM_RERANK_AUTH_APP_SECRET=your-app-secret
# LLM_RERANK_AUTH_AUTHORIZATION=Bearer your-token
# LLM_RERANK_API_KEY=your-secret
# Compose-only: the host path that docker-compose.yml mounts at
# /opt/registry-center/etc/config/models.yaml. The service reads the mounted
# file (or LLM_CONFIG_FILE) and never reads this variable.
# LLM_CONFIG_HOST_FILE=/absolute/shared/models.yaml


# Connections: etc/conf/db/*.json; see docs/database-configuration.md.
# Only secrets belong here by default; each password_env names a variable.
# POSTGRES_PASSWORD=your-local-secret
# MYSQL_PASSWORD=your-local-secret
# DATABASE_CONFIG_DIR=etc/conf/db
# GAUSS_PASSWORD=your-local-secret
# AUDIT_MYSQL_PASSWORD=your-audit-secret
# NEO4J_PASSWORD=your-local-secret
# MILVUS_TOKEN=your-optional-token
